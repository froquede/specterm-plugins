{
  "name": "specterm-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Specterm plugins, one folder each",
  "type": "module",
  "scripts": {
    "build": "npm run build:todo && npm run build:wallpaper",
    "build:todo": "vite build --config todo/vite.config.ts && node todo/build.mjs",
    "build:wallpaper": "vite build --config wallpaper/vite.config.ts && node wallpaper/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test todo/test/*.test.mjs wallpaper/test/*.test.mjs",
    "e2e:todo": "node todo/test/e2e.mjs",
    "e2e:wallpaper": "node wallpaper/test/e2e.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "lucide-solid": "^1.28.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0",
    "zod": "4.6.5"
  }
}
